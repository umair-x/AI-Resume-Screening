# ==============================
# BACKEND
# ==============================

backend/venv/
backend/.env

backend/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/**/*.pyd

# User uploaded private files
backend/uploads/*
backend/profile_images/*

# Keep empty folders if .gitkeep exists
!backend/uploads/.gitkeep
!backend/profile_images/.gitkeep


# ==============================
# FRONTEND
# ==============================

frontend/node_modules/
frontend/dist/

frontend/.env
frontend/.env.local
frontend/.env.production


# ==============================
# IDE / SYSTEM FILES
# ==============================

.vscode/
.idea/

.DS_Store
Thumbs.db

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*


# ==============================
# PYTHON CACHE
# ==============================

__pycache__/
*.py[cod]
*$py.class


# ==============================
# TEMP FILES
# ==============================

*.tmp
*.temp